{
  "_comment": "Third-party apps checked against PieFed by interop/run.sh apps (interop/apps/README.md). Each app runs login, view and post; a step with no expectation must pass. An expectation records a known non-pass and why: unsupported = PieFed lacks the API the app speaks (docs/superpowers/specs/2026-11-07-mastodon-client-api-design.md), blocked = an earlier step did not pass, inapplicable = the app has no such step. Driven apps say how (web: a URL served in the stack; apk: where the newest release comes from); probed apps name the protocol family whose first calls are sent (probes.py).",
  "apps": {
    "voyager-web": {"platform": "lemmy", "surface": "web", "web": "https://voyager.test", "image": "ghcr.io/aeharding/voyager:latest"},
    "blorp-web": {"platform": "lemmy", "surface": "web", "web": "https://blorp.test", "image": "ghcr.io/blorp-labs/blorp:latest"},
    "photon-web": {"platform": "lemmy", "surface": "web", "web": "https://photon.test", "image": "ghcr.io/xyphyn/photon:latest"},
    "voyager-android": {"platform": "lemmy", "surface": "android", "package": "app.vger.voyager", "apk": {"fdroid": "app.vger.voyager"}},
    "thunder-android": {"platform": "lemmy", "surface": "android", "package": "com.hjiangsu.thunder",
                        "apk": {"github": "thunder-app/thunder", "asset": "x86_64\\.apk$", "prerelease": true}},
    "summit-android": {"platform": "lemmy", "surface": "android", "package": "com.idunnololz.summit.fdroid", "apk": {"fdroid": "com.idunnololz.summit.fdroid"}},
    "jerboa-android": {"platform": "lemmy", "surface": "android", "probe": "lemmy-v3", "expect": {
      "login": {"outcome": "unsupported", "reason": "Jerboa speaks only Lemmy's /api/v3; PieFed serves its own /api/alpha"},
      "view": {"outcome": "unsupported", "reason": "Jerboa reads posts from /api/v3/post/list, which PieFed does not serve"},
      "post": {"outcome": "blocked", "reason": "posting needs the login Jerboa cannot do"}}},

    "mastodon-android": {"platform": "mastodon", "surface": "android", "package": "org.joinmastodon.android", "apk": {"fdroid": "org.joinmastodon.android"}},
    "tusky-android": {"platform": "mastodon", "surface": "android", "package": "com.keylesspalace.tusky", "apk": {"fdroid": "com.keylesspalace.tusky"}},
    "moshidon-android": {"platform": "mastodon", "surface": "android", "probe": "mastodon"},
    "phanpy-web": {"platform": "mastodon", "surface": "web", "web": "https://phanpy.test", "image": "phanpy (newest release, built by run.sh)"},
    "elk-web": {"platform": "mastodon", "surface": "web", "web": "https://elk.test", "image": "ghcr.io/elk-zone/elk:latest"},

    "pixelfed-android": {"platform": "pixelfed", "surface": "android", "probe": "mastodon"},
    "pixeldroid-android": {"platform": "pixelfed", "surface": "android", "probe": "mastodon"},
    "fedilab-android": {"platform": "pixelfed", "surface": "android", "probe": "mastodon"},

    "peertube-android": {"platform": "peertube", "surface": "android", "package": "org.framasoft.peertube", "apk": {"fdroid": "org.framasoft.peertube"}},
    "newpipe-android": {"platform": "peertube", "surface": "android", "package": "org.schabi.newpipe", "apk": {"github": "TeamNewPipe/NewPipe", "asset": "\\.apk$"}, "expect": {
      "login": {"outcome": "inapplicable", "reason": "NewPipe has no accounts: it only browses"},
      "post": {"outcome": "inapplicable", "reason": "NewPipe cannot upload"}}},
    "tubelab-android": {"platform": "peertube", "surface": "android", "probe": "tubelab", "expect": {
      "login": {"outcome": "unsupported", "reason": "TubeLab reads nodeinfo first and logs in only where it says peertube; PieFed's says piefed (ruling P4: TubeLab is left out)"},
      "view": {"outcome": "unsupported", "reason": "the probe browses piefed.test, which is private (R219): /api/v1/videos answers 401 there with no login, and TubeLab cannot log in"},
      "post": {"outcome": "blocked", "reason": "uploading needs the login TubeLab cannot do"}}},

    "antennapod-android": {"platform": "castopod", "surface": "android", "package": "de.danoeh.antennapod", "apk": {"fdroid": "de.danoeh.antennapod"}, "expect": {
      "login": {"outcome": "inapplicable", "reason": "podcast players subscribe to a public feed; there is no account"},
      "post": {"outcome": "inapplicable", "reason": "podcast players do not publish"}}},
    "pocketcasts-android": {"platform": "castopod", "surface": "android", "rss": true, "expect": {
      "login": {"outcome": "inapplicable", "reason": "podcast players subscribe to a public feed; there is no account"},
      "post": {"outcome": "inapplicable", "reason": "podcast players do not publish"}}},
    "podcastaddict-android": {"platform": "castopod", "surface": "android", "rss": true, "expect": {
      "login": {"outcome": "inapplicable", "reason": "podcast players subscribe to a public feed; there is no account"},
      "post": {"outcome": "inapplicable", "reason": "podcast players do not publish"}}}
  }
}
