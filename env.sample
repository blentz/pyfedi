# You must set SECRET_KEY to a random sequence of numbers and letters, surrounded by a single quote.
SECRET_KEY=''
SERVER_NAME='127.0.0.1:5000'
DATABASE_URL=postgresql+psycopg2://pyfedi:pyfedi@127.0.0.1/pyfedi

# Where PieFed reads the client IP address from. It is used for rate limiting, IP
# bans, the honeypot ban, geolocation and the audit trail, so it must come from
# something the client cannot set for itself.
#
#   Caddy, nginx, or any single reverse proxy in front of PieFed: LEAVE THIS EMPTY.
#   PieFed then uses the connection's remote address, which ProxyFix already takes
#   from the last entry your proxy appended to X-Forwarded-For. Nothing to set.
#
#   Cloudflare or a similar CDN: set it to the header the CDN writes the real
#   client into, e.g. TRUSTED_CLIENT_IP_HEADER='CF-Connecting-IP'. Use this only
#   when that header is written by the CDN on every request and a client sending
#   the same header cannot reach PieFed directly - otherwise anyone can pick their
#   own IP and walk past your rate limits and bans.
#
# If the named header contains a comma-separated list, PieFed uses the LAST entry:
# each hop appends what it saw, so the last entry is the one your own proxy wrote.
TRUSTED_CLIENT_IP_HEADER=''
# Only for an instance that also answers on a .onion address. The one address of the
# reverse proxy that carries the onion traffic (Caddy's internal listener), which sets
# X-PieFed-Via: onion. A request is treated as onion only when it carries that header
# AND comes from this address; then the shared Tor address is not used for bans,
# geolocation, stored IPs or rate limits. Unset means no request is treated as onion.
#ONION_PROXY_IP='10.89.0.2'
MAIL_SERVER=''
MAIL_PORT=0
# True: STARTTLS (usually port 587). False or unset: implicit TLS (usually port 465)
MAIL_USE_TLS=True
MAIL_USERNAME=''
MAIL_PASSWORD=''
MAIL_TIMEOUT=30
MAIL_FROM=''
ERRORS_TO=''
# At most one error report per this many seconds per process; the rest stay in the log
ERROR_MAIL_INTERVAL=300

CACHE_TYPE='FileSystemCache'
CACHE_DIR='/dev/shm/pyfedi'
CELERY_BROKER_URL='redis://localhost:6379/1'
CACHE_REDIS_URL='redis://localhost:6379/1'
# The onion's state (app/onion_store.py): a separate Redis with persistence off (save "", appendonly no, no volume),
# so nothing an onion request does survives a reboot. Not a database of the Redis above, which persists to disk.
#ONION_REDIS_URL='redis://onion-redis:6379/0'

BOUNCE_ADDRESS=''
BOUNCE_HOST=''
BOUNCE_HOST_TYPE='imap'
BOUNCE_USERNAME=''
BOUNCE_PASSWORD=''

FLASK_APP = 'pyfedi.py'
SENTRY_DSN = ''

# For real-time notifications. See https://codeberg.org/PieFed/piefed-notifs
NOTIF_SERVER = 'https://your-domain.tld'

AWS_REGION = 'ap-southeast-2'

CLOUDFLARE_API_TOKEN = ''
CLOUDFLARE_ZONE_ID = ''

IPINFO_TOKEN = ''

# leave at 0 to automatically fetch core count
NUM_CPU = 0

# Encrypts payment provider credentials stored in the database. Make one with: flask generate-payment-key
# To rotate, put the new key first, comma separated: new,old. Back it up apart from the database.
PAYMENT_SECRETS_KEY = ''

# Connected accounts: members' Bluesky, Facebook, Instagram and YouTube tokens are encrypted under this key. Make one
# with: flask generate-payment-key (any Fernet key). Rotate as PAYMENT_SECRETS_KEY. Back it up apart from the database.
CONNECTIONS_SECRETS_KEY = ''
# Each service is offered only when its app's credentials are set (and switched on at Admin > Connected accounts).
# Bluesky: an ES256 private JWK, made with: flask connections-bluesky-key. Needs SERVER_NAME on a public domain.
BLUESKY_OAUTH_KEY = ''
# Rarely changed: where Bluesky DIDs and handles resolve, and where a member who types no handle signs in
# BLUESKY_PLC_URL = 'https://plc.directory'
# BLUESKY_RESOLVER = 'https://bsky.social'
# BLUESKY_DEFAULT_SERVER = 'https://bsky.social'
# Facebook Pages, and Instagram through Facebook Login: a Meta app with Facebook Login for Business
FACEBOOK_APP_ID = ''
FACEBOOK_APP_SECRET = ''
# FACEBOOK_GRAPH_VERSION = 'v27.0'   # the Graph API version PieFed calls; raise it when Meta retires this one
# Instagram through Instagram Login (no Facebook Page needed): the Instagram app id of the same Meta app
INSTAGRAM_APP_ID = ''
INSTAGRAM_APP_SECRET = ''
# YouTube: a Google OAuth client with the YouTube Data API v3 enabled
YOUTUBE_OAUTH_CLIENT_ID = ''
YOUTUBE_OAUTH_SECRET = ''

# Deprecated: connect Stripe at Admin > Payments instead. These are read only until they have been imported there.
STRIPE_SECRET_KEY = ''
STRIPE_PUBLISHABLE_KEY = ''
STRIPE_MONTHLY_SMALL = ''
STRIPE_MONTHLY_SMALL_TEXT = 'Pay $5 per month'
STRIPE_MONTHLY_BIG = ''
STRIPE_MONTHLY_BIG_TEXT = 'Pay $10 per month'
WEBHOOK_SIGNING_SECRET = ''

# Shared secret for the plugin /webhook endpoint. Senders must put it in an X-Webhook-Secret header.
# Leave empty to disable the endpoint (it answers 404).
WEBHOOK_SECRET = ''

ENABLE_ALPHA_API = 'true'

# CORS configuration for API routes (defaults to '*' if not set)
CORS_ALLOW_ORIGIN = '*'

PAGE_LENGTH = 75

# Send account details to this ldap server
LDAP_SERVER = '127.0.0.1'
LDAP_PORT = 389
LDAP_USE_SSL = 0
LDAP_USE_TLS = 0
LDAP_WRITE_ENABLE = 0
LDAP_WRITE_BIND_DN = 'cn=admin,dc=piefed,dc=social'
LDAP_WRITE_BIND_PASSWORD = 'your password here'
LDAP_BASE_DN = 'ou=users,dc=piefed,dc=social'
LDAP_WRITE_USER_FILTER = '(uid={username})'
LDAP_WRITE_ATTR_USERNAME = 'uid'
LDAP_WRITE_ATTR_EMAIL = 'mail'
LDAP_WRITE_ATTR_PASSWORD = 'userPassword'


# Largest request body (e.g. an upload) accepted, in bytes. Bigger requests get 413. Default 100 MB.
# Images are separately capped at 10 MB; raise this if you allow large video uploads.
MAX_CONTENT_LENGTH = 104857600

MEDIA_IMAGE_MAX_DIMENSION = 2000
MEDIA_IMAGE_FORMAT = ''
MEDIA_IMAGE_QUALITY = 90
MEDIA_IMAGE_THUMBNAIL_FORMAT = 'WEBP'
MEDIA_IMAGE_THUMBNAIL_QUALITY = 93
MEDIA_IMAGE_MEDIUM_FORMAT = 'JPEG'
MEDIA_IMAGE_MEDIUM_QUALITY = 90

# number of months to keep local user voting data, defaults to 6 if not set. Use -1 to never delete.
# KEEP_LOCAL_VOTE_DATA_TIME = 6

# number of months to keep remote user voting data, defaults to 6 if not set. Use -1 to never delete.
# KEEP_REMOTE_VOTE_DATA_TIME = 6

# If you have a header that contains the country code, set it here, if available this will be used rather than the IPInfo information.
# For example if you want to use Cloudflare's IP geolocation, uncomment the following line
# COUNTRY_SOURCE_HEADER='CF-IPCountry'

# Stop comments and votes on posts after X months and save their data to S3/disk to minimize DB size growth. 0 to disable.
# ARCHIVE_POSTS = 0

# For use with Libretranslate
TRANSLATE_ENDPOINT = ''
TRANSLATE_KEY = ''

# Federation will pause once this much redis memory is used. Default is 200 MB. -1 to disable memory check.
REDIS_MEMORY_LIMIT = 200000000

# This quota is not used for creating image posts, only when inserting images into the body of posts or comments.
FILE_UPLOAD_QUOTA = 52428800

# How many votes someone can cast per day
VOTE_QUOTA = 240

# Force scrapers to do a proof-of-work challenge to make life harder for them.
ANOOBIS = 1
ANOOBIS_DIFFICULTY_DESKTOP = 22
ANOOBIS_DIFFICULTY_MOBILE = 14

# Allow people to add RSS feeds to communities
# RSS_FEEDS = 1