# TLS termination for PieFed. Used by compose.prod.yaml on the VPS.
# Caddy obtains and renews the Let's Encrypt certificate automatically; there is no
# certbot and no renewal cron. Certificates and the ACME account key live in the
# caddy_data volume -- losing that volume forces re-issuance and can trip Let's
# Encrypt rate limits (5 certs per domain per week).
{
	# Let's Encrypt sends expiry and problem notices here. CHANGE THIS.
	email {$ACME_EMAIL}
}

# Shared by the clearnet and onion sites, so their handlers cannot drift apart.
(piefed_routes) {
	encode zstd gzip

	# Media uploads (deploy/DEPLOY_GUIDE.md, "Media uploads"): the largest upload limit, max_video_upload_bytes
	# (default 524288000, 500 MiB), plus 10 MiB for the rest of the form. MiB, not MB: Caddy reads "MB" as 10^6
	# bytes, and 510MB is less than 500 MiB. The app still refuses anything over its own per-request limit.
	request_body {
		max_size 510MiB
	}

	# The browser opens this as an EventSource, so it has to be same-origin over TLS.
	# FastAPI already serves the route at /notifications/stream (fastapi_server.py:46),
	# so no path rewriting is needed. flush_interval -1 disables response buffering,
	# without which server-sent events arrive in chunks instead of live.
	# Match that one path only: Flask serves other /notifications/... routes (e.g.
	# /notifications/all_read), and a wildcard sent them to FastAPI, which 404s.
	handle /notifications/stream {
		reverse_proxy piefednotifs:8000 {
			flush_interval -1
		}
	}

	# The Live view's wake-up stream (fastapi_server.py, /live/stream). Same unbuffered proxying.
	handle /live/stream {
		reverse_proxy piefednotifs:8000 {
			flush_interval -1
		}
	}

	# While the app restarts (migrations, preload) web:5000 refuses connections, and Caddy
	# answered every inbox delivery with 502; senders that do not retry lost the activity.
	# Hold the request and retry the dial instead. A refused dial is retried for any method,
	# POST included, because nothing has been sent upstream yet.
	#
	# Cached onion media: the app answers a cache hit with an empty 200 and X-Accel-Redirect: /<file>, and Caddy
	# serves that file itself from the cache dir, mounted read-only at /srv/media_proxy. Only the onion storefront
	# ever sends the header, so on the clearnet site this is inert. file_server handles Range (206).
	reverse_proxy web:5000 {
		lb_try_duration 30s
		lb_try_interval 250ms

		@accel header X-Accel-Redirect *
		handle_response @accel {
			root * /srv/media_proxy
			rewrite * {rp.header.X-Accel-Redirect}
			header X-Content-Type-Options nosniff
			header Content-Security-Policy "default-src 'none'; sandbox"
			# A signed URL names fixed content. handle_response copies no upstream header, so Caddy sets this itself.
			# Only when the file exists: eviction can delete it after the route's hit, and that 404 must not be kept.
			# header runs before rewrite, so the matcher names the accel path, not {path}.
			@present file {rp.header.X-Accel-Redirect}
			header @present Cache-Control "public, max-age=604800, immutable"
			file_server
		}
	}
}

{$PIEFED_DOMAIN} {
	# Only the onion site below may mark a request as onion; a client cannot forge the marker here.
	request_header -X-PieFed-Via
	# Tor Browser offers the onion address to visitors of the clearnet site.
	header Onion-Location http://gnzxnayrrmwidxmnmhibwzazwkssf7wkl7i2dpx2izof54yz4am5qzad.onion{uri}
	import piefed_routes
}

# A second federating domain (deploy/DEPLOY_GUIDE.md, "Adding a federating domain"). Add the domain in the admin
# Domains form first, point its DNS here, then uncomment this block, replace shop.example, and reload Caddy. It
# gets the same routing as the first domain and no Onion-Location header: that header names the onion site of the first domain.
